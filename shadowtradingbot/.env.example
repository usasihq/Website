# Copy to .env and fill in. Never commit .env.
# chmod 600 .env
#
# These override ~/.pyhood/crypto.env when both are set.
# Leave them blank to use the pyhood credentials file instead.

RH_CRYPTO_API_KEY=
RH_CRYPTO_PRIVATE_KEY=

# Optional. The code caps these: notional cannot exceed $1,
# positions cannot exceed 1, daily loss cannot exceed $0.50.
# Smaller values are allowed.
SHADOW_SYMBOL=BTC-USD
SHADOW_MAX_NOTIONAL_USD=1
SHADOW_DAILY_LOSS_USD=0.50
SHADOW_DIP_PCT=0.01
SHADOW_TAKE_PROFIT_PCT=0.015
SHADOW_WINDOW=20
SHADOW_INTERVAL_SECONDS=30

# Simulated cash for paper mode. Live orders ignore this and use
# the account's real buying power.
SHADOW_PAPER_CASH=10
