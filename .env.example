# Optional build-time settings. Nothing here is secret.
# Canonical origin used for sitemap, canonical URLs and social metadata.
NEXT_PUBLIC_SITE_URL=https://unitedstatesofamericasuperintelligence.com
# Repository sub-path when served from https://<user>.github.io/<repo>/ (leave empty for a custom domain).
NEXT_PUBLIC_BASE_PATH=
# Official USAJOBS Search API. Refresh skips federal jobs if the key is unset; never commit a key.
# USAJOBS_API_KEY=
# Registered email for the User-Agent header (defaults to usasi@usasihq.com).
# USAJOBS_USER_AGENT=usasi@usasihq.com
# Google Indexing API service-account JSON (one line). Refresh skips the ping if unset; never commit the key.
# The service account must be added as an Owner of the site in Google Search Console.
# GOOGLE_INDEXING_SA_JSON=

