// Cloudflare Workers — static assets only (no Worker script, no server code).
// `npm run build` writes ./out; `npx wrangler deploy` uploads it.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usasi",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./out",
    // Unknown paths get out/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /companies → 307 → /companies/ (matches Next's trailingSlash: true export).
    "html_handling": "auto-trailing-slash"
  },
  // Owner step (see SETUP_REQUIRED.md): after the domain's DNS zone is on
  // Cloudflare, uncomment to serve the apex domain from this Worker.
  // "routes": [
  //   { "pattern": "unitedstatesofamericasuperintelligence.com", "custom_domain": true }
  // ],
  "workers_dev": true,
  "preview_urls": true
}
