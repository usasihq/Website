// Cloudflare Workers — static assets plus a small script for the moved people
// and jobs sections. `npm run build` writes ./out; `npx wrangler deploy` uploads it.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usasi",
  "main": "worker.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Unknown paths get out/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /companies → 307 → /companies/ (matches Next's trailingSlash: true export).
    "html_handling": "auto-trailing-slash",
    // Navigation requests would otherwise get 404.html before the Worker runs.
    // /people, /big-si, /voices, /local: 301 to aipeoplewiki.com (people-redirect-map.json);
    // /jobs: 301 to aipeoplewiki.com/jobs/ (same path, with exception rules);
    // listing both the bare and the /* form so no variant reaches the 307 trailing-slash step.
    // /jobs/* already covers /jobs/at/*; a second rule is rejected as redundant.
    "run_worker_first": [
      "/people", "/people/*",
      "/big-si", "/big-si/*",
      "/voices", "/voices/*",
      "/local", "/local/*",
      "/jobs", "/jobs/*",
      "/sitemaps/*",
      "/sitemap-jobs-*.xml"
    ]
  },
  // Custom domains (the zone is in the owner's Cloudflare account). Cloudflare
  // creates the DNS records and certificates. Canonical URLs use the apex.
  "routes": [
    { "pattern": "unitedstatesofamericasuperintelligence.com", "custom_domain": true },
    { "pattern": "www.unitedstatesofamericasuperintelligence.com", "custom_domain": true }
  ],
  // Served only on the domain: the account's workers.dev address and preview
  // URLs are disabled so the account subdomain is not exposed.
  "workers_dev": false,
  "preview_urls": false
}
